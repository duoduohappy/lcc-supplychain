# Copy this file to .env only after SIA approves the direct-connect application.
# Values are supplied by SIA/Amadeus during partner onboarding; never commit .env.
PORT=8787
APP_ORIGINS=http://localhost:8787,https://duoduohappy.github.io

SIA_NDC_ENDPOINT_URL=
SIA_NDC_AUTH_HEADER_NAME=Authorization
SIA_NDC_AUTH_HEADER_VALUE=
SIA_NDC_CONTENT_TYPE=application/xml; charset=utf-8
SIA_NDC_SELLER_ID=
SIA_NDC_DISTRIBUTOR_ID=
SIA_NDC_POS_COUNTRY=CN


